# --- Base de datos -----------------------------------------------------------
# Cadena de conexión de Postgres (Neon). Si se deja vacía en local, la app usa
# una base de datos embebida PGlite en ./.pglite (solo para desarrollo).
DATABASE_URL=

# --- Panel de administración ------------------------------------------------
# Contraseña única para entrar en /admin
ADMIN_PASSWORD=cambia-esta-contrasena

# Secreto para firmar la cookie de sesión del admin.
# Genera uno con:  openssl rand -base64 32
ADMIN_SESSION_SECRET=cambia-este-secreto-largo-y-aleatorio

# --- Web pública ------------------------------------------------------------
# URL pública del sitio (se usa para el código QR y las metaetiquetas).
# En producción, p. ej. https://aspas-cafe.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
